{
  "name": "comprestack/sdk",
  "description": "Official PHP SDK for the Comprestack image optimization API",
  "type": "library",
  "license": "MIT",
  "keywords": ["comprestack", "image", "compression", "webp", "avif", "sdk"],
  "homepage": "https://www.comprestack.com/docs",
  "support": {
    "docs": "https://www.comprestack.com/docs#sdk",
    "source": "https://github.com/MichaelGenesisII/Comprestack-PHP-SDK"
  },
  "authors": [
    {
      "name": "Comprestack"
    }
  ],
  "require": {
    "php": "^8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Comprestack\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Comprestack\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
